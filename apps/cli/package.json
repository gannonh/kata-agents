{
  "name": "@kata-sh/agents-cli",
  "version": "0.10.3",
  "license": "Apache-2.0",
  "description": "Terminal client for Kata Agent server",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "kata-agents-cli": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=es2022 --outfile=dist/cli.js --log-level=warning",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/"
  },
  "dependencies": {
    "@kata-sh/shared": "workspace:*",
    "@kata-sh/server-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "@types/bun": "latest"
  }
}
