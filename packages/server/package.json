{
  "name": "@kata-sh/server",
  "version": "0.10.3",
  "description": "Standalone headless Kata Agent server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "kata-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "Gannon Hall",
    "email": "support@kata.sh"
  },
  "license": "Apache-2.0",
  "homepage": "https://agents.kata.sh",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kata-sh/core": "workspace:*",
    "@kata-sh/messaging-gateway": "workspace:*",
    "@kata-sh/server-core": "workspace:*",
    "@kata-sh/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "ws": "^8.16.0"
  }
}
