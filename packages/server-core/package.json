{
  "name": "@kata-sh/server-core",
  "version": "0.10.3",
  "license": "Apache-2.0",
  "description": "Reusable headless server infrastructure for Kata Agent",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./transport": "./src/transport/index.ts",
    "./transport/codec": "./src/transport/codec.ts",
    "./runtime": "./src/runtime/index.ts",
    "./handlers": "./src/handlers/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./model-fetchers": "./src/model-fetchers/index.ts",
    "./domain": "./src/domain/index.ts",
    "./services": "./src/services/index.ts",
    "./git": "./src/git/index.ts",
    "./handlers/rpc": "./src/handlers/rpc/index.ts",
    "./handlers/rpc/*": "./src/handlers/rpc/*.ts",
    "./handlers/push-sources-changed": "./src/handlers/push-sources-changed.ts",
    "./sessions": "./src/sessions/index.ts",
    "./computer": "./src/computer/index.ts",
    "./handoffs": "./src/handoffs/index.ts",
    "./katacode": "./src/katacode/index.ts",
    "./webui": "./src/webui/index.ts",
    "./routines": "./src/routines/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@kata-sh/core": "workspace:*",
    "@kata-sh/shared": "workspace:*",
    "jose": "^6.0.0",
    "playwright-core": "1.55.0",
    "sharp": "0.34.5",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0"
  }
}
